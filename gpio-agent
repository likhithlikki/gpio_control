#!/bin/sh
### BEGIN INIT INFO
# Provides:          gpio-agent
# Required-Start:    $network $remote_fs
# Default-Start:     3 5
# Default-Stop:      0 1 6
# Short-Description: Internet GPIO controller agent
### END INIT INFO
# Install as /etc/init.d/gpio-agent  (chmod +x), then link it into the runlevel dir.

DAEMON=/usr/local/bin/gpio-agent.sh
PIDFILE=/var/run/gpio-agent.pid

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "$1" in
  start)
    if is_running; then echo "gpio-agent already running"; exit 0; fi
    printf "Starting gpio-agent: "
    "$DAEMON" >/dev/null 2>&1 </dev/null &
    echo $! > "$PIDFILE"
    echo "done"
    ;;
  stop)
    printf "Stopping gpio-agent: "
    if is_running; then kill "$(cat "$PIDFILE")"; fi
    rm -f "$PIDFILE"
    echo "done (pins keep their last state)"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if is_running; then echo "gpio-agent running (pid $(cat "$PIDFILE"))"; else echo "gpio-agent not running"; exit 1; fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
