#!/bin/sh
### BEGIN INIT INFO
# Provides:          gpio-agent
# Required-Start:    $network $remote_fs
# Default-Start:     3 5
# Default-Stop:      0 1 6
# Short-Description: Internet GPIO controller agent
### END INIT INFO
# Install as /etc/init.d/gpio-agent  (chmod +x), then link it into the runlevel dir.

DAEMON=/usr/local/bin/gpio-agent.sh
PIDFILE=/var/run/gpio-agent.pid
NETD=/usr/local/bin/gpio-net.sh
NETPID=/var/run/gpio-net.pid
INFOD=/usr/local/bin/gpio-info.sh
INFOPID=/var/run/gpio-info.pid

running() {
  [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null
}

case "$1" in
  start)
    if running "$PIDFILE"; then echo "gpio-agent already running"; exit 0; fi
    printf "Starting gpio-agent: "
    if [ -x "$NETD" ] && ! running "$NETPID"; then
      "$NETD" >/dev/null 2>&1 </dev/null &
      echo $! > "$NETPID"
    fi
    if [ -x "$INFOD" ] && ! running "$INFOPID"; then
      "$INFOD" >/dev/null 2>&1 </dev/null &
      echo $! > "$INFOPID"
    fi
    "$DAEMON" >/dev/null 2>&1 </dev/null &
    echo $! > "$PIDFILE"
    echo "done"
    ;;
  stop)
    printf "Stopping gpio-agent: "
    if running "$PIDFILE"; then kill "$(cat "$PIDFILE")"; fi
    if running "$NETPID"; then kill "$(cat "$NETPID")"; fi
    if running "$INFOPID"; then kill "$(cat "$INFOPID")"; fi
    rm -f "$PIDFILE" "$NETPID" "$INFOPID"
    echo "done (pins keep their last state)"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if running "$PIDFILE"; then echo "gpio-agent running (pid $(cat "$PIDFILE"))"; else echo "gpio-agent not running"; exit 1; fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
